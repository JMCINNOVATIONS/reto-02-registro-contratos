# Configuración del Servidor
PORT=3000

# Proveedor LLM: "gemini" | "openai" | "mock" (por defecto si no se especifican llaves)
LLM_PROVIDER=mock

# Google Gemini API (Opcional - si se desea usar Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API (Opcional - si se desea usar OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
